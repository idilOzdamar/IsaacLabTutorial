    </actuator>
  </transmission>
  <transmission name="rb_kairos_16_ur16e_wrist_1_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rb_kairos_16_ur16e_wrist_1_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rb_kairos_16_ur16e_wrist_1_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rb_kairos_16_ur16e_wrist_2_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rb_kairos_16_ur16e_wrist_2_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rb_kairos_16_ur16e_wrist_2_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rb_kairos_16_ur16e_wrist_3_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rb_kairos_16_ur16e_wrist_3_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rb_kairos_16_ur16e_wrist_3_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rb_kairos_16_ur16e_wrist_3_link_flange_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rb_kairos_16_ur16e_wrist_3_link_flange_fixed_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rb_kairos_16_ur16e_wrist_3_link_flange_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <gazebo reference="rb_kairos_16_ur16e_base_link">
    <selfCollide>False</selfCollide>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
    <minDepth>0.001</minDepth>
    <maxVel>0</maxVel>
  </gazebo>
  <gazebo reference="rb_kairos_16_ur16e_shoulder_link">
    <selfCollide>False</selfCollide>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="rb_kairos_16_ur16e_upper_arm_link">
    <selfCollide>False</selfCollide>
    <mu1>0.2</mu1>
    <mu2>0.2</mu2>
  </gazebo>
  <gazebo reference="rb_kairos_16_ur16e_forearm_link">
    <selfCollide>False</selfCollide>
