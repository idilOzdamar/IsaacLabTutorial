  <gazebo>
    <plugin filename="libgazebo_ros_ft_sensor.so" name="rb_kairos_16_ur16e_flange_ft_sensor">
      <updateRate>100.0</updateRate>
      <!-- <topicName>${prefix}/ft_sensor</topicName> -->
      <topicName>wrench</topicName>
      <jointName>rb_kairos_16_ur16e_wrist_3_link_flange_fixed_joint</jointName>
    </plugin>
  </gazebo>
  <!-- **************** -->
  <!-- FT sensor plugin -->
  <!-- **************** -->
  <gazebo>
    <plugin filename="libgazebo_ros_ft_sensor.so" name="rb_kairos_16_ur16e_flange_ft_sensor">
      <updateRate>100.0</updateRate>
      <topicName>ur16e_ft_sensor</topicName>
