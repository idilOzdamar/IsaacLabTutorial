  <!-- ROS base_link to UR 'Base' Coordinates transform -->
  <link name="rb_kairos_16_ur16e_base"/>
  <joint name="rb_kairos_16_ur16e_base_link_base_fixed_joint" type="fixed">
    <!-- NOTE: this rotation is only needed as long as base_link itself is
                 not corrected wrt the real robot (ie: rotated over 180
                 degrees)
      -->
    <origin rpy="0 0 -3.14159" xyz="0 0 0"/>
    <parent link="rb_kairos_16_ur16e_base_link"/>
    <child link="rb_kairos_16_ur16e_base"/>
  </joint>
  <!-- Frame coincident with all-zeros TCP on UR controller -->
  <!-- <link name="${prefix}tool0"/>
    <joint name="${prefix}wrist_3_link_tool0_fixed_joint" type="fixed">
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <parent link="${prefix}wrist_3_link"/>
      <child link="${prefix}tool0"/>
    </joint> -->
  <link name="rb_kairos_16_ur16e_flange">
    <inertial>
      <mass value="0.202"/>
      <origin rpy="0 0 0" xyz="0.0 0 0.0"/>
      <inertia ixx="0.00014434577559500002" ixy="0.0" ixz="0.0" iyy="0.00014434577559500002" iyz="0.0" izz="0.00020452500000000002"/>
    </inertial>
  </link>
  <joint name="rb_kairos_16_ur16e_wrist_3_link_flange_fixed_joint" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="rb_kairos_16_ur16e_wrist_3_link"/>
    <child link="rb_kairos_16_ur16e_flange"/>
  </joint>
  <joint name="rb_kairos_16_joint_ur16e_link0_base_footprint" type="fixed">
    <parent link="rb_kairos_16_base_chapa"/>
    <child link="rb_kairos_16_ur16e_base_link"/>
    <origin rpy="0 0 0" xyz="0.189 0.0 0.35"/>
  </joint>
  <!-- *************** -->
  <!-- UR16e extension -->
  <!-- *************** -->
  <link name="rb_kairos_16_ur16e_extension">
    <inertial>
      <origin rpy="0 0 0" xyz="0 0 0"/>
      <mass value="1"/>
      <inertia ixx="1.0" ixy="0.0" ixz="0.0" iyy="1.0" iyz="0.0" izz="1.0"/>
    </inertial>
    <visual>
      <origin rpy="0 0 0" xyz="0 0 -0.175"/>
      <geometry>
        <cylinder length="0.35" radius="0.095"/>
      </geometry>
      <material name="black"/>
    </visual>
    <collision>
      <origin rpy="0 0 0" xyz="0 0 -0.175"/>
      <geometry>
        <cylinder length="0.35" radius="0.095"/>
      </geometry>
    </collision>
  </link>
  <gazebo reference="rb_kairos_16_ur16e_extension">
    <material>Gazebo/Black</material>
  </gazebo>
  <joint name="rb_kairos_16_ur16e_joint_extension" type="fixed">
    <origin rpy="0 0 0" xyz="0.189 0.0 0.35"/>
    <parent link="rb_kairos_16_base_chapa"/>
    <child link="rb_kairos_16_ur16e_extension"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- ******* -->
  <!-- Gripper -->
  <!-- ******* -->
  <!-- This file unifies all sensors that can be used on simulation, defined as xacro:macros -->
  <link name="rb_kairos_16_ur16e_EE"/>
  <joint name="rb_kairos_16_ur16e_joint_EE" type="fixed">
    <origin rpy="0 0 0" xyz="0 0 0"/>
    <parent link="rb_kairos_16_ur16e_flange"/>
    <child link="rb_kairos_16_ur16e_EE"/>
    <axis xyz="0 0 0"/>
  </joint>
  <!-- *********** -->
  <!-- Pole camera -->
  <!-- *********** -->
  <!-- ************ -->
  <!-- Base Plugins -->
  <!-- ************ -->
  <gazebo>
    <plugin filename="libgazebo_ros_force_based_move.so" name="ros_force_based_move">
      <commandTopic>robotnik_base_control/cmd_vel</commandTopic>
      <odometryTopic>robotnik_base_control/diff_drive_odom</odometryTopic>
      <odometryFrame>rb_kairos_16_odom</odometryFrame>
      <yaw_velocity_p_gain>10000.0</yaw_velocity_p_gain>
      <x_velocity_p_gain>100000.0</x_velocity_p_gain>
      <y_velocity_p_gain>100000.0</y_velocity_p_gain>
      <robotBaseFrame>rb_kairos_16_base_footprint</robotBaseFrame>
      <odometryRate>50.0</odometryRate>
      <publishOdometryTf>False</publishOdometryTf>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros_odometry.so" name="ros_gazebo_odometry">
      <alwaysOn>true</alwaysOn>
      <updateRate>50.0</updateRate>
      <bodyName>rb_kairos_16_base_footprint</bodyName>
      <topicName>robotnik_base_control/odom</topicName>
      <gaussianNoise>0.01</gaussianNoise>
      <odomFrameName>rb_kairos_16_odom</odomFrameName>
    </plugin>
  </gazebo>
  <gazebo>
    <plugin filename="libgazebo_ros_control.so" name="ros_control">
      <!--<robotNamespace>/summit_xl</robotNamespace>-->
      <robotParam>robot_description</robotParam>
      <controlPeriod>0.001</controlPeriod>
      <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
      <legacyModeNS>true</legacyModeNS>
    </plugin>
  </gazebo>
  <!-- <xacro:if value="$(arg base_gazebo_ros_control)">
        <xacro:ros_control/>
        <gazebo>
            <plugin name="${arm_prefix}ros_control" filename="libgazebo_ros_control.so">
                
                <robotSimType>gazebo_ros_control/DefaultRobotHWSim</robotSimType>
                <legacyModeNS>true</legacyModeNS>
                <updateRate>1000.0</updateRate>
            </plugin>
        </gazebo>
    </xacro:if> -->
  <transmission name="rb_kairos_16_ur16e_shoulder_pan_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rb_kairos_16_ur16e_shoulder_pan_joint">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
    </joint>
    <actuator name="rb_kairos_16_ur16e_shoulder_pan_motor">
      <hardwareInterface>hardware_interface/EffortJointInterface</hardwareInterface>
      <mechanicalReduction>1</mechanicalReduction>
    </actuator>
  </transmission>
  <transmission name="rb_kairos_16_ur16e_shoulder_lift_trans">
    <type>transmission_interface/SimpleTransmission</type>
    <joint name="rb_kairos_16_ur16e_shoulder_lift_joint">
