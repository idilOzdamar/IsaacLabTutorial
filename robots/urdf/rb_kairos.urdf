  </gazebo>
  <gazebo reference="rb_kairos_16_ur16e_shoulder_pan_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="rb_kairos_16_ur16e_shoulder_lift_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="rb_kairos_16_ur16e_elbow_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
    <provideFeedback>true</provideFeedback>
  </gazebo>
  <gazebo reference="rb_kairos_16_ur16e_wrist_1_joint">
    <implicitSpringDamper>1</implicitSpringDamper>
